{
  "schemaVersion": 1,
  "id": "lan-over-direct",
  "version": "${version}",
  "name": "LAN over Direct",
  "description": "Play together over Apple peer-to-peer Wi-Fi. No router, no network, no setup.",
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.lanoverdirect.LanOverDirectClient"]
  },
  "mixins": [
    {
      "config": "lan-over-direct.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
