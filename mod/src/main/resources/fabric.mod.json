{
  "schemaVersion": 1,
  "id": "lan-over-direct",
  "version": "${version}",
  "name": "LAN over Direct",
  "description": "Play together over Apple peer-to-peer Wi-Fi (AWDL). No router, no network, no setup. macOS only, client-side only.",
  "authors": [
    "Devin Wilson"
  ],
  "license": "MIT",
  "icon": "assets/lan-over-direct/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.lanoverdirect.LanOverDirectClient"
    ],
    "fabric-client-gametest": [
      "dev.lanoverdirect.gametest.ScreenSmokeTest"
    ]
  },
  "mixins": [
    {
      "config": "lan-over-direct.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.1 <26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
