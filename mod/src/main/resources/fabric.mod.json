{
  "schemaVersion": 1,
  "id": "awdl-lan",
  "version": "${version}",
  "name": "AWDL LAN",
  "description": "Play together over Apple peer-to-peer Wi-Fi (AWDL). No router, no network, no setup. macOS only, client-side only.",
  "authors": [
    "Devin Wilson"
  ],
  "license": "MIT",
  "icon": "assets/awdl-lan/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.awdllan.AwdlLanClient"
    ],
    "fabric-client-gametest": [
      "dev.awdllan.gametest.ScreenSmokeTest"
    ]
  },
  "mixins": [
    {
      "config": "awdl-lan.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": ">=26.1 <26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "contact": {
    "homepage": "https://modrinth.com/mod/awdl-lan",
    "sources": "https://github.com/Dev869/awdl-lan",
    "issues": "https://github.com/Dev869/awdl-lan/issues"
  }
}
